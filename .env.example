# --- Nimiq --------------------------------------------------------------
# "mainnet" or "testnet". Must match the network Nimiq Pay runs on.
NIM_NETWORK=mainnet
# Public Albatross JSON-RPC (rpc-mainnet.nimiqscan.com also works).
NIM_RPC_URL=https://rpc.nimiqwatch.com
NIM_MIN_CONFIRMATIONS=2

# The circle pool wallet. `npm run pool -- keygen` fills both in.
# The private key is only read by scripts/pool.mjs, never by the web app.
POOL_ADDRESS=
POOL_PRIVATE_KEY=

# Validator the pool delegates to. Default: Nimiq Marketing Pool
# (0% fee, restakes rewards hourly, so yield shows up as stake growth).
STAKE_VALIDATOR=NQ08 RS08 LTKL 62QL B954 S9YP 0G3R XVKM RU2Y

# --- Off-ramp -----------------------------------------------------------
# "mock" until the real provider adapter is written.
OFFRAMP_PROVIDER=mock

# --- App ----------------------------------------------------------------
# Signs session cookies. Any long random string.
SESSION_SECRET=
# SQLite file locally; a libsql:// Turso URL in production.
DATABASE_URL=file:data/circle.db
DATABASE_AUTH_TOKEN=
# Dev only (ignored when NODE_ENV=production): fake wallet + simulated payments,
# so flows can be tested in a desktop browser without Nimiq Pay.
DEV_WALLET=1
# Dev/demo: pay a round out as soon as everyone has chipped in, instead of on its date.
INSTANT_PAYOUTS=1
# Operator-owned NIM sitting in the pool (excluded from member yield).
POOL_FLOAT_NIM=0

# --- Treasury (float model, src/lib/treasury.ts) ------------------------
# Margin on the NIM leg, covering price moves until the next rebalance.
TREASURY_SPREAD_BPS=150
QUOTE_TTL_SECONDS=90
CASHOUT_MAX_USDT=250
CASHOUT_DAILY_MAX_USDT=1000
CASHOUT_MIN_NGN=200
# Optional: CoinGecko demo key, and a NIM/USD price to use if CoinGecko is down.
COINGECKO_API_KEY=
NIM_USD_FALLBACK=

# --- Worker -------------------------------------------------------------
# Runs every minute inside the server. WORKER=off to disable.
WORKER=
# Protects POST /api/cron/tick.
CRON_SECRET=
# off | dry (log the plan) | on (send staking transactions)
AUTO_STAKE=off
POOL_LIQUID_BUFFER_NIM=50
# Adds an "Every 10 min" cadence for demo videos.
DEMO_CADENCE=

# Breaking a locked personal goal: disabled until a fee is chosen.
# Basis points: 100 = 1%. Allowed 1..9999. Example only: 500 = 5%.
GOAL_BREAK_FEE_BPS=
# principal = saved amount only; total = saved amount + earned rewards.
GOAL_BREAK_FEE_BASIS=principal
